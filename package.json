{
  "name": "ygo-card-manager",
  "version": "0.1.0",
  "description": "Yu-Gi-Oh card manager desktop app",
  "main": "src/main/main.js",
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"electron .\"",
    "build": "vite build && electron-builder",
    "start": "electron .",
    "test": "vitest run",
    "test:integration": "node tests/integration.js",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.5",
    "cheerio": "^1.0.0-rc.12",
    "electron": "^28.2.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron-builder": "^24.9.1",
    "eslint": "^8.57.0",
    "vite": "^5.1.4",
    "vitest": "^1.2.2"
  },
  "build": {
    "appId": "com.example.ygo-card-manager",
    "productName": "YGO Card Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "dist/renderer/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
